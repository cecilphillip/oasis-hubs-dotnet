<Project Sdk="Microsoft.NET.Sdk">
    <Sdk Name="Aspire.AppHost.Sdk" Version="9.4.0" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>9be0b115-1a83-43e9-9e88-c47257cbbc99</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost" Version="9.4.1" />
        <PackageReference Include="Aspire.Hosting.RabbitMQ" Version="9.4.1" />
        <PackageReference Include="Aspire.Hosting.Redis" Version="9.4.1" />       
        <PackageReference Include="Aspire.Hosting.SqlServer" Version="9.4.1" />
    </ItemGroup>

    <ItemGroup>
      <Content Include=".config\rabbitmq\rabbitmq_enabled_plugins" />
      <Content Include=".config\redis\redis.conf" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\OasisHubs.BackgroundProcessor\OasisHubs.BackgroundProcessor.csproj" />
      <ProjectReference Include="..\OasisHubs.DataInitializer\OasisHubs.DataInitializer.csproj" />
      <ProjectReference Include="..\OasisHubs.Site\OasisHubs.Site.csproj" />
    </ItemGroup>

</Project>
